---
/*
 * The landing page's structural trick (docs/shep-design/README.md,
 * "Landing page > Structure" table + the top-level "THE STRUCTURAL TRICK"
 * note). One relative wrapper holds, in z-order:
 *
 *   0  fixed sky gradient spanning the whole stage (night -> dawn -> noon)
 *   1  stars / moon / sun / sheep-silhouette puffs, positioned in vh down
 *      the stage
 *   2  a STICKY pasture (position:sticky; top:0; height:100vh;
 *      margin-bottom:-100vh) so the scenery pins while content scrolls —
 *      since build 4 it also carries a band of dawn fog over the far hill
 *   3  a night wash that multiplies over the top and fades out
 *   4  a barn glow, second sticky layer
 *   5+ <slot /> — the five content scenes, the lexicon, features,
 *      chalkboard and CTA footer: everything below the nav lives INSIDE
 *      this wrapper, because the stage's total height (driven by slotted
 *      content) is what the sticky pasture pins against, and the sections
 *      are transparent so the scene runs behind them to the footer.
 *
 * Scroll is the passage of time here (night -> dawn -> noon), and the sky
 * plays it out: stars, moon, sun and the puffs each scroll at their own
 * fraction of content speed, the night sky dissolves as the dawn comes up,
 * and time-based ambients (wind sway, shooting stars, sun/moon glow) keep
 * the scene breathing even when the page is still. See THE SPEED MODEL
 * comment above the parallax rules at the bottom of this file for the whole
 * choreography and how to tune it. Each drifting component restates its own
 * share of those rules in its own <style>: the celestial bodies in
 * CelestialBodies.astro, the puffs in Clouds.astro.
 */
import Sheep from "../marks/Sheep.astro";
import Dog from "../marks/Dog.astro";
import Barn from "../marks/Barn.astro";
import Tuft from "./Tuft.astro";
import CelestialBodies from "./CelestialBodies.astro";
import Clouds from "./Clouds.astro";

const posts = [30, 180, 330, 480, 630, 780, 930, 1080, 1230, 1350];

/*
 * Roaming animals visit the pasture and leave the way they came (the
 * `roam` keyframes in motion.css: enter from --roam-from, graze at
 * --roam-visit, one small --roam-shift step, graze, exit — negative
 * delays start each one mid-visit so the pasture is never suddenly empty
 * at load). Visit spots are chosen OFF the resident grazers' lanes so no
 * sheep ever walks through another — the fix for the old edge-to-edge
 * crossings reading as z-order bugs. Each visit spot has a grass tuft
 * planted at it (the tufts config below) so the stops read as eating.
 * Fleece colors are illustration literals like the marks' own: a
 * moorit-brown ewe trailing a white lamb up front, a black sheep and a
 * white ewe with a brown lamb far back. Lambs gambol instead of bobbing.
 * The far groups take the same desaturate/brighten treatment and
 * behind-the-fence z-index as the far grazer; widths are clamp()ed in
 * the styles below, per depth and per adult/lamb, for the same
 * footprint-shrinks-with-viewport reason.
 */
interface RoamerSpec {
  depth: "mid" | "far";
  from: string;
  visit: string;
  shift: string;
  facingRight: boolean;
  duration: string;
  delay: string;
  bottom: string;
  width: number;
  fleece?: string;
  bobDuration: string;
  bobDelay: string;
  trotDuration: string;
  lamb?: { width: number; fleece?: string; gambolDuration: string };
}

const roaming: RoamerSpec[] = [
  {
    depth: "mid",
    from: "-28vw",
    visit: "14vw",
    shift: "4vw",
    facingRight: true,
    duration: "88s",
    delay: "-34s",
    bottom: "4.5vh",
    width: 64,
    fleece: "#b5895f",
    bobDuration: "5.1s",
    bobDelay: ".6s",
    trotDuration: "0.9s",
    lamb: { width: 36, gambolDuration: "1.15s" },
  },
  {
    depth: "far",
    from: "108vw",
    visit: "58vw",
    shift: "-4vw",
    facingRight: false,
    duration: "120s",
    delay: "-58s",
    bottom: "17vh",
    width: 48,
    fleece: "#4b463d",
    bobDuration: "6.2s",
    bobDelay: ".2s",
    trotDuration: "1.05s",
  },
  {
    depth: "far",
    from: "-28vw",
    visit: "27vw",
    shift: "3vw",
    facingRight: true,
    duration: "140s",
    delay: "-118s",
    /* 14.5vh, in front of the resident far grazer's 16vh lane: its entry
       crosses that sheep's x, and lower-on-screen must paint nearer for
       the pass to read as depth instead of a glitch. */
    bottom: "14.5vh",
    width: 44,
    bobDuration: "6.9s",
    bobDelay: ".9s",
    trotDuration: "1.1s",
    /* width >= 32 so Sheep.astro's build-time legs rule keeps the lamb's
       legs — 28 produced a legless blob bouncing across the far hill. */
    lamb: { width: 34, fleece: "#b5895f", gambolDuration: "0.95s" },
  },
];

/*
 * Grass tufts. Positions land on the spots where an animal actually
 * stands still — each grazer's walk plateau (home + ~55% of its walk
 * amplitude) and each roamer's visit spot — so a stopped, bobbing sheep
 * reads as eating, plus a few decorative extras. `far` tufts render in a
 * layer just after the far hill (behind the fog, fence and every animal)
 * and take the far-depth filter; near ones sit on the near hill under
 * the fence. Retune these alongside the grazing/roaming configs above —
 * a tuft nobody stops at is scenery, a stop with no tuft is a sheep
 * staring at nothing. Both layers draw through the one Tuft.astro
 * component, so a retune here is the whole change.
 */
interface TuftSpec {
  left: string;
  bottom: string;
  width: number;
  far?: boolean;
  flip?: boolean;
}

const tufts: TuftSpec[] = [
  { left: "11.5%", bottom: "15.8vh", width: 22, far: true },
  { left: "56%", bottom: "16.8vh", width: 24, far: true, flip: true },
  { left: "28.5%", bottom: "14.2vh", width: 22, far: true },
  { left: "42%", bottom: "19vh", width: 18, far: true, flip: true },
  { left: "84%", bottom: "16.2vh", width: 20, far: true },
  { left: "31%", bottom: "2.6vh", width: 30 },
  { left: "53.5%", bottom: "1.6vh", width: 32, flip: true },
  { left: "16%", bottom: "4.3vh", width: 28 },
  { left: "70%", bottom: "3vh", width: 26, flip: true },
];

/*
 * Depth for the grazing sheep: far/mid/near controls width (a clamp() in
 * the stylesheet, not a fixed px, so the footprint itself shrinks with the
 * viewport instead of only its position), walk speed, height against the
 * hill, and z-index (the far sheep paints behind .fence — see that rule).
 * left/bottom are home positions; --walk-amp is how far each one wanders
 * from home before turning back (see the `walk` keyframes in motion.css).
 * These lanes plus the dog's fixed spot were checked against each other at
 * 320px — the tightest width, since every sheep's clamp() is pinned to its
 * min there — with a positive clearance margin at every boundary; wider
 * viewports only add more room. See the .depth-* / .watch-dog rules below.
 */
const grazing = [
  {
    depth: "far",
    left: "10%",
    bottom: "16vh",
    width: 52,
    bobDuration: "6.8s",
    bobDelay: ".3s",
    chewing: false,
    trotDuration: "1.1s",
    walkAmp: "2.5vw",
    walkDuration: "34s",
    walkDelay: "0s",
  },
  {
    depth: "mid",
    left: "30%",
    // 3vh, not the original 8vh: at 8vh the mid sheep's feet landed inside
    // .fence's own band (bottom:7vh/54px tall, or bottom:4vh below 600px) at
    // ordinary viewport heights, painting its legs directly over a rail
    // since depth-mid is in front (z-index 3 > the fence's 2) — it read as
    // standing on the fence. 3vh keeps its feet below the fence's bottom
    // edge at both breakpoints (matching how the near sheep already clears
    // it: its feet sit well past the fence's bottom rather than at the same
    // height as a rail), while its back still rises in front of the fence
    // as it walks past — a clean occlusion, not a coincidental balance.
    bottom: "3vh",
    width: 72,
    bobDuration: "5.6s",
    bobDelay: ".8s",
    chewing: true,
    trotDuration: "0.95s",
    walkAmp: "2vw",
    walkDuration: "24s",
    walkDelay: "1.4s",
  },
  {
    depth: "near",
    left: "52%",
    bottom: "2vh",
    width: 92,
    bobDuration: "4.8s",
    bobDelay: "0s",
    chewing: false,
    trotDuration: "0.85s",
    walkAmp: "2.5vw",
    walkDuration: "17s",
    walkDelay: "2.6s",
  },
];
---

<div class="stage">
  <div class="sky-gradient"></div>

  <CelestialBodies />

  <Clouds />

  <div class="pasture" aria-hidden="true">
    <div class="far-hill">
      <svg viewBox="0 0 1200 210" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 118C170 62 360 132 560 104 760 76 950 30 1200 84V210H0Z"
          fill="var(--illus-far-hill)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="tuft-layer far" aria-hidden="true">
      {tufts
        .filter((t) => t.far)
        .map((t) => (
          <Tuft {...t} />
        ))}
    </div>

    <div class="barn">
      <Barn width={300} />
    </div>

    <div class="mist"></div>

    <div class="near-hill">
      <svg viewBox="0 0 1200 260" preserveAspectRatio="none" width="100%" height="100%">
        <path
          d="M0 92C220 52 470 116 700 88 930 60 1050 96 1200 70V260H0Z"
          fill="var(--grass)"
          stroke="var(--ink)"
          stroke-width="4"
        />
      </svg>
    </div>

    <div class="tuft-layer" aria-hidden="true">
      {tufts
        .filter((t) => !t.far)
        .map((t) => (
          <Tuft {...t} />
        ))}
    </div>

    <div class="fence">
      <svg viewBox="0 0 1400 76" preserveAspectRatio="none" width="100%" height="100%">
        <g fill="var(--fleece)" stroke="var(--ink)" stroke-width="4">
          <rect x="0" y="22" width="1400" height="12" rx="3" />
          <rect x="0" y="48" width="1400" height="12" rx="3" />
          {posts.map((a) => <path d={`M${a} 74V14l14-10 14 10v60Z`} />)}
        </g>
      </svg>
    </div>

    {grazing.map((sheep) => (
      <div
        class={`grazing-sheep depth-${sheep.depth} anim-walk`}
        style={`left:${sheep.left};bottom:${sheep.bottom};--walk-amp:${sheep.walkAmp};--walk-duration:${sheep.walkDuration};--walk-delay:${sheep.walkDelay};`}
      >
        <Sheep
          width={sheep.width}
          bob
          bobDuration={sheep.bobDuration}
          bobDelay={sheep.bobDelay}
          chewing={sheep.chewing}
          trot
          trotDuration={sheep.trotDuration}
        />
      </div>
    ))}

    <div class="watch-dog">
      <Dog width={126} wag />
    </div>

    {roaming.map((r) => (
      <div
        class={`roamer roamer-${r.depth} anim-roam`}
        style={`bottom:${r.bottom};--roam-from:${r.from};--roam-visit:${r.visit};--roam-shift:${r.shift};--face-in:${r.facingRight ? -1 : 1};--roam-duration:${r.duration};--roam-delay:${r.delay};`}
      >
        <div class="trek">
          <Sheep
            width={r.width}
            fleece={r.fleece}
            bob
            bobDuration={r.bobDuration}
            bobDelay={r.bobDelay}
            trot
            trotDuration={r.trotDuration}
          />
          {r.lamb && (
            <div class="lamb" style={`--gambol-duration:${r.lamb.gambolDuration};`}>
              <Sheep width={r.lamb.width} fleece={r.lamb.fleece} class="anim-gambol" />
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="night-wash"></div>

  <div class="barn-glow-layer">
    <div class="barn-glow"></div>
  </div>

  <slot />
</div>

<style>
  .stage {
    position: relative;
    /* Belt-and-braces against horizontal scroll from decorative overhang
       (first offender: the sun's ::before halo past the right edge at
       narrow widths). `clip`, never `hidden`: hidden would make the stage
       a scroll container and silently kill the sticky pasture — the bug
       that flattened the whole scroll effect once already — while clip
       only clips paint and creates no scroll container, leaving sticky
       and the scroll-driven timelines alone. */
    overflow-x: clip;
    /*
     * Mirrors SceneSection.astro's own layout math (.inner's max-width and
     * padding, and the widest columnWidth of the five scenes — Scene2's
     * min(660px,56vw)) so --col-right always lands on the actual right edge
     * of the widest scene column at the current viewport width. Anything
     * placed at left:var(--col-right) or further right is guaranteed clear
     * of every scene's copy, at every width, instead of by coincidence.
     */
    --inner-max: 1240px;
    --inner-pad: 28px;
    --col-cap: 660px;
    --col-vw: 56vw;
    --inner-left: max(
      var(--inner-pad),
      calc((100vw - var(--inner-max)) / 2 + var(--inner-pad))
    );
    --col-right: calc(var(--inner-left) + min(var(--col-cap), var(--col-vw)));
  }

  @media (max-width: 680px) {
    /* SceneSection.astro forces every column to min(92vw,520px) below this
       same breakpoint — match it so --col-right stays accurate. */
    .stage {
      --col-cap: 520px;
      --col-vw: 92vw;
    }
  }

  .sky-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    /*
     * Stops rescaled x0.743 from the original five-scene calibration when
     * the lexicon/features/chalkboard/CTA sections moved inside the stage
     * (stage 5484px -> 7380px at the 1440x900 tuning baseline): the same
     * multiplier on every stop keeps night and dawn at the same absolute
     * scroll positions as before, and the added page tail simply extends
     * the noon hold. If more sections ever join the stage, rescale again
     * by old-stage-height / new-stage-height.
     */
    background: linear-gradient(
      180deg,
      #0e1730 0%,
      #152342 3.6%,
      #26386a 7.6%,
      #4c4a83 11.1%,
      #8c5f84 14.2%,
      #c97a5a 17.2%,
      #e7a468 20.3%,
      #f1c98d 23.3%,
      #dde6e0 27.3%,
      #bfe2f2 32.4%,
      #9bd8f1 38.5%,
      #b9e5f7 44.6%,
      #cfebf8 50.7%,
      #cfebf8 100%
    );
  }

  .pasture {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
    /* The far-depth atmosphere, declared once for its three consumers
       (.tuft-layer.far, .depth-far, .roamer-far — all inside .pasture) so
       a retune can't drift them apart. Custom properties inherit through
       the DOM, so they keep working if a consumer moves into a child
       component.

       Desaturate and lift only — no opacity() term: translucent animals
       read as ghosts (the fence showed straight through the black sheep),
       and atmospheric distance comes through the contrast drop alone. */
    --atmo: saturate(0.58) brightness(1.07);
  }

  .far-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 8%;
    height: 43vh;
  }

  .near-hill {
    position: absolute;
    left: -4%;
    right: -4%;
    bottom: 0;
    height: 27vh;
  }

  .fence {
    position: absolute;
    left: -6%;
    right: -6%;
    bottom: 7vh;
    height: 54px;
    /* Above the hills' implicit stacking order but below the near/mid sheep
       and dog (z-index 3) — the far sheep (z-index 1) sits behind this on
       purpose, so it reads as grazing on the other side of the fence. */
    z-index: 2;
  }

  .barn {
    position: absolute;
    right: 6%;
    bottom: 26%;
    width: min(300px, 26vw);
  }

  /* Barn.astro sizes its own wrapper from the `width` prop (a fixed px
     figure for a standalone mark); here it must instead fill this
     already-responsive min(300px,26vw) container. */
  .barn :global(.barn-mark) {
    width: 100% !important;
  }

  /*
   * Dawn fog over the far hill and the barn's feet. It sits in the sticky
   * pasture between the barn and the near hill (paint order is DOM order
   * here), so the near meadow, fence and animals all stay crisp in front
   * of it while the far scenery goes hazy. Base opacity 0: it only exists
   * through its scroll-driven keyframes (mist-cycle below) — thin before
   * first light, thickest at dawn, burned off by mid-morning — so browsers
   * without scroll-driven animations, and reduced-motion visitors, never
   * see a stuck noon fog. The night wash multiplies over it (z-index 3 vs
   * the pasture's 2), which keeps it a dim grey bank before first light
   * rather than a bright cream one.
   */
  .mist {
    position: absolute;
    left: -3%;
    right: -3%;
    bottom: 21%;
    height: 26vh;
    opacity: 0;
    background:
      radial-gradient(
        58% 60% at 22% 62%,
        rgba(251, 246, 231, 0.75),
        rgba(251, 246, 231, 0) 70%
      ),
      radial-gradient(
        46% 64% at 58% 42%,
        rgba(251, 246, 231, 0.6),
        rgba(251, 246, 231, 0) 72%
      ),
      radial-gradient(
        50% 55% at 88% 60%,
        rgba(251, 246, 231, 0.7),
        rgba(251, 246, 231, 0) 70%
      );
    /* The band is a hard-edged box, and any fog ellipse whose soft falloff
       reaches past it gets sliced flat at the boundary — the middle puff's
       vertical reach crossed the band's top and drew a visible straight
       edge across the night sky. The mask fades the band's own edges so
       nothing inside it can ever terminate in a hard line, whatever the
       ellipse geometry above does. */
    -webkit-mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 24%,
      #000 76%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      transparent 0%,
      #000 24%,
      #000 76%,
      transparent 100%
    );
  }

  .tuft-layer {
    position: absolute;
    inset: 0;
  }

  .tuft-layer.far {
    filter: var(--atmo);
  }

  .grazing-sheep {
    position: absolute;
  }

  /*
   * Depth: width is a clamp() rather than the Sheep.astro `width` prop's
   * fixed px, so the footprint itself shrinks with the viewport (the same
   * fluid-figure fix the barn's min() and the dog's clamp() widths use)
   * instead of only its position — a fixed-px sheep next to a percentage
   * lane is exactly how bug 2 happened. Further-away sheep are
   * also smaller, higher up (bigger `bottom`, set inline per-instance),
   * slower to walk, and desaturated/brightened to lose contrast against the
   * hill, plus the far one paints behind .fence (z-index 1 < fence's 2).
   */
  .depth-far {
    z-index: 1;
    filter: var(--atmo);
  }

  .depth-far :global(.sheep-mark) {
    width: clamp(34px, 4.4vw, 58px) !important;
  }

  .depth-mid {
    z-index: 3;
  }

  .depth-mid :global(.sheep-mark) {
    width: clamp(48px, 6.2vw, 84px) !important;
  }

  .depth-near {
    z-index: 3;
  }

  .depth-near :global(.sheep-mark) {
    width: clamp(60px, 8vw, 108px) !important;
  }

  .watch-dog {
    position: absolute;
    right: 6%;
    bottom: 4vh;
    z-index: 3;
  }

  .watch-dog :global(.dog-mark) {
    width: clamp(56px, 9.4vw, 126px) !important;
  }

  /*
   * Roamers sit at left:0 and are carried across by the roam keyframes'
   * translateX; the same var(--roam-from) as a static transform keeps them
   * parked offscreen for reduced-motion visitors, who would otherwise find
   * a stranger standing in the middle of the pasture. `.trek` carries the
   * facing flip on its own element so it can't fight the roam transform,
   * and the lamb always trails its ewe: it is the second flex child, and
   * the flip mirrors the whole group, so the adult leads in both
   * directions.
   */
  .roamer {
    position: absolute;
    left: 0;
    transform: translateX(var(--roam-from, -30vw));
  }

  .trek {
    display: flex;
    align-items: flex-end;
    gap: 7px;
  }

  .roamer-mid {
    z-index: 3;
  }

  .roamer-far {
    z-index: 1;
    filter: var(--atmo);
  }

  .roamer-mid :global(.sheep-mark) {
    width: clamp(44px, 5.6vw, 78px) !important;
  }

  .roamer-far :global(.sheep-mark) {
    width: clamp(30px, 4vw, 56px) !important;
  }

  .roamer-mid .lamb :global(.sheep-mark) {
    width: clamp(26px, 3.2vw, 42px) !important;
  }

  .roamer-far .lamb :global(.sheep-mark) {
    width: clamp(22px, 2.6vw, 34px) !important;
  }

  .night-wash {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    mix-blend-mode: multiply;
    /* Stops rescaled x0.743 with the sky gradient's — see that note. */
    background: linear-gradient(
      180deg,
      rgba(16, 26, 52, 0.72) 0%,
      rgba(16, 26, 52, 0.66) 6.1%,
      rgba(22, 34, 64, 0.5) 11.1%,
      rgba(40, 40, 72, 0.3) 15.2%,
      rgba(90, 70, 60, 0.12) 19.2%,
      rgba(255, 255, 255, 0) 24.3%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  .barn-glow-layer {
    position: sticky;
    top: 0;
    height: 100vh;
    margin-bottom: -100vh;
    z-index: 4;
    pointer-events: none;
  }

  .barn-glow {
    position: absolute;
    /*
     * Centers the glow on the barn: barn's own right offset (6%) plus half
     * the barn's width minus half the glow's own 132px. Below ~500px the
     * barn (min(300px,26vw)) shrinks past 132px, so the raw calc goes
     * negative — a negative `right` pushes this box's right edge past the
     * container's right edge, which is exactly what forced the page to
     * scroll horizontally at 320px. max(0px, ...) keeps the glow pinned to
     * the barn's right edge instead of overshooting past it once the barn
     * is smaller than the glow itself.
     */
    right: max(0px, calc(6% + min(300px, 26vw) / 2 - 66px));
    bottom: calc(26% + min(300px, 26vw) * 0.62 - 66px);
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(247, 228, 176, 0.72) 0%,
      rgba(243, 196, 76, 0.34) 36%,
      rgba(243, 196, 76, 0) 70%
    );
  }

  /* Responsive first pass (docs/shep-design/README.md, "Responsive": "scenery
     reduced to a band rather than removed"). The sheep/dog footprints are
     already fluid (the clamp() widths above), so this tightens the hill
     band on short mobile viewports — and everything ANCHORED to the
     desktop hill band must move with it. The barn and mist are re-seated
     onto the shrunken far hill (26% of the viewport floated the barn in
     open sky once the hill dropped to 22vh), the barn's glow repeats the
     barn's own bottom so it stays centered on the hayloft, and the front
     line — the dog and the visiting mid roamer — drops below the fence's
     lowered bottom edge, which is the same feet-clear-of-the-bottom-rail
     rule the mid grazer's 3vh was originally chosen for. The roamer's
     bottom is inline (per-instance), hence the !important. */
  @media (max-width: 600px) {
    .far-hill,
    .near-hill {
      height: 22vh;
    }

    .fence {
      bottom: 8vh;
    }

    .barn {
      bottom: 18vh;
    }

    .barn-glow {
      bottom: calc(18vh + min(300px, 26vw) * 0.62 - 66px);
    }

    .mist {
      bottom: 10vh;
      height: 18vh;
    }

    .watch-dog {
      bottom: 1.2vh;
    }

    .roamer-mid {
      bottom: 1.8vh !important;
    }
  }

  /*
   * Parallax (build 4) — THE SPEED MODEL.
   *
   * Scroll on this page is the passage of time, so the sky is choreographed
   * as a time-lapse rather than as generic lag: the stars linger and
   * dissolve into first light, the moon hangs pale into the morning before
   * fading, the sun climbs slowly off the hills and hangs through the day
   * scenes, and every cloud runs at its own depth-scaled speed. Depth comes
   * from the SPREAD of those speeds — build 2's mistake was giving every
   * layer the same drift, which reads as one slightly-slow background.
   *
   * Every drifting element moves at a UNIFORM fraction r of content speed
   * for as long as it is on screen. Builds 2-3 proved the two naive routes
   * both fail: scroll(root) drift diluted over the whole ~7-viewport page
   * is invisible (18vh of drift = ~25px per screenful), and a plain view()
   * drift is spent inside one viewport-crossing, so the element crawls and
   * then snaps back to full speed partway up the screen. The fix is to
   * stretch each animation's window to exactly the element's SLOWED time on
   * screen, so the drift rate is constant and the animation completes just
   * as the element leaves — no kink, no dilution:
   *
   *     on-screen span at 1x = S  (in vh of scroll)
   *     window = S / r            drift = S * (1 - r) / r
   *
   * Two timelines, split by where the element starts:
   *
   * - Starts below the fold (sun, clouds 2-5): animation-timeline: view()
   *   with animation-range `cover 0% cover (100/r)%`. S is one viewport
   *   plus the element's own height; the height term is deliberately
   *   dropped (S = 100vh) so the drift errs a few percent SMALL — the
   *   animation then finishes just after the element exits (invisible)
   *   instead of just before (a visible speed-up at the top edge).
   *
   * - Visible at scroll 0 (stars, moon, first cloud): a view() timeline
   *   would already be partially elapsed at load, and fill:both would
   *   displace them from their authored positions before any scrolling
   *   happens. They run on animation-timeline: scroll(root) with an
   *   explicit `0% <S/r>` range instead — S is the element's document
   *   bottom edge in vh, and at scroll 0 the range's progress is exactly
   *   0, so the load composition holds.
   *
   * Numbers in play (r, S -> range, drift):
   *
   *     stars   r 0.30, S 36vh -> range 120vh,       drift  84vh, fades
   *     moon    r 0.10, S 17vh -> range 170vh,       drift 153vh, fades
   *     sun     r 0.45         -> range cover 222%,  drift 122vh, eased
   *              (the rules for all three in CelestialBodies.astro)
   *     clouds  r per instance -> cloudMotion() in clouds.ts, the rules in
   *              Clouds.astro
   *
   * The stars and moon also FADE (the sky-drift-fade* keyframes — stars
   * across the back 45% of their range, the moon over 25%-65%, timed to
   * its own slower departure) — that is what turns "slow parallax" into
   * "swallowed by the dawn", and it forgives the S estimates above: a star
   * field that lingers a touch long is invisible before it could clash
   * with the day sky. The sun instead gets an ease-out timing function:
   * the drift is spent fastest at the start, where it cancels the most
   * scroll, so the sun sits nearly still at the hilltop at first light and
   * accelerates away toward noon. (The curve's initial slope times
   * drift/window must stay below 1 or the sun would visibly move DOWN
   * while the page scrolls; the pair below has it rising at ~0.2x off the
   * horizon: slope 0.5/0.3 = 1.67, drift/window = 122/249 = 0.49.)
   *
   * Gates: every scroll-driven rule sits behind @supports
   * (animation-timeline: ...) so browsers without scroll-driven animations
   * (Firefox at this build) get the static 1x sky — never a stuck offset —
   * while still getting every time-based ambient (twinkle, wind sway,
   * shooting stars, glow breathing). Everything, ambient included, sits
   * behind reduced-motion, same as motion.css.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /*
       * Deliberately longhand, not the `animation` shorthand: Astro's CSS
       * minifier (Lightning CSS) folds a shorthand `animation` declaration
       * plus a separate `animation-timeline` into one shorthand value, and
       * as of this build it produces `animation:linear both sky-parallax
       * scroll(root)`, a value the browser itself then rejects as invalid,
       * silently dropping the whole declaration (confirmed via the CSSOM:
       * the compiled rule's selector survives, its body is empty). The
       * longhand properties do not hit that merge path. animation-range is
       * kept out of any shorthand for the same reason. (The time-based
       * ambients in the components may use the shorthand: they set no
       * timeline, so there is nothing for the minifier to fold in.)
       *
       * Shared base for every scroll-driven element still drawn here —
       * now only the fog. Astro scopes a selector to its own component's
       * markup, so every other member is restated in the component that
       * draws it: star, moon and sun in CelestialBodies.astro, the puffs
       * in Clouds.astro.
       */
      .mist {
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
      }

      /* The fog reads overall page progress: its subject (the sticky
         pasture) is always on screen, so view() would be meaningless — the
         whole scroll range IS its dawn-and-burn-off day. */
      .mist {
        animation-name: mist-cycle;
        animation-timeline: scroll(root);
      }
    }
  }

  /* Percentages are of the whole scroll: fog on the pasture from before
     first light, thickest as the dawn band crosses, burned off by the time
     the sky turns full blue. */
  @keyframes mist-cycle {
    0% {
      opacity: 0.55;
    }
    20% {
      opacity: 0.75;
    }
    38% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>
